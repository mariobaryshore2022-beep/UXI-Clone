# ==============================================================================
# UXI Sensor Clone - Environment Configuration
# ==============================================================================

# Server Port
PORT=3000

# PostgreSQL Connection String (Leave empty to use zero-config embedded PGlite WASM)
# DATABASE_URL=postgresql://uxi:uxipassword@localhost:5432/uxi_db
# PGHOST=localhost
# PGPORT=5432
# PGUSER=uxi
# PGPASSWORD=uxipassword
# PGDATABASE=uxi_db

# Webhook Alerting URL (Slack / Microsoft Teams / Generic HTTP)
# WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXXX

# Sensor Client Settings
SENSOR_ID=sensor-n100-01
SENSOR_NAME="HQ-Floor3-East (Intel N100)"
SENSOR_MODE=sensor
SERVER_URL=http://localhost:3000
TEST_INTERFACE=wlan1
MGMT_INTERFACE=eth0
SIMULATE=false
CYCLE_INTERVAL=15
AGENT_INTERVAL=300
