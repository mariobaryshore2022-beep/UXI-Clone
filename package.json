{
  "name": "pulse-ux-hub",
  "version": "1.0.0",
  "description": "Pulse UX Hub - Digital Experience Monitoring & Synthetic Network Telemetry platform with Pulse UX Sensor fleet",
  "main": "server/src/server.js",
  "bin": {
    "pulse-sensor": "client/bin/pulse-sensor",
    "uxi-sensor": "client/bin/pulse-sensor"
  },
  "scripts": {
    "start": "node server/src/server.js",
    "hub": "node server/src/server.js",
    "server": "node server/src/server.js",
    "sensor": "node client/bin/pulse-sensor",
    "sensor:simulate": "node client/bin/pulse-sensor --simulate",
    "sensor:agent": "node client/bin/pulse-sensor --mode=agent",
    "client": "node client/bin/pulse-sensor",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "pulse-ux",
    "pulse-ux-hub",
    "pulse-ux-sensor",
    "digital-experience-monitoring",
    "synthetic-testing",
    "wifi-monitoring",
    "voip-mos",
    "network-telemetry"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "pg": "^8.17.2"
  }
}
